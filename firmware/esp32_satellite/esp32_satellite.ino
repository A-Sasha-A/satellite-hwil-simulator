#define MIN_MANEUVER_DURATION_S       10.0
#define APOGEE_WINDOW_RAD             0.20      // ±11.5°: window for eccentricity correction (thrust at apogee)
#define HALL_POWER_PERCENT            100       // [%] power when active
#define HALL_ONLY_IN_SUNLIGHT         1         // 1 = never fire in eclipse (no power from panels)
