// --- Sun-Synchronous Orbit (SSO) + Repeat Ground Track ---
// Goal: keep a, e~0, i constant -> SSO + repeat track happen automatically.
#define NOMINAL_A_KM                  6878.14
#define MAX_ECCENTRICITY              3.0e-3    
#define NOMINAL_INCLINATION_DEG       97.4
#define NOMINAL_LTAN_H                10.5      // e.g., 10:30 LTAN (Sentinel-2 style)
#define TARGET_REVS                   227       // Repeat track: 227 revolutions over 15 days
#define TARGET_DAYS                   15

// Tolerances (hysteresis: outside -> maneuver, inside -> coasting)
#define A_TOLERANCE_KM                0.5
#define A_DEADBAND_KM                 0.1
#define E_TOLERANCE                   5.0e-4    // Maneuver if e > MAX_ECCENTRICITY + E_TOLERANCE = 3.5e-3
#define I_TOLERANCE_DEG               0.02
#define LTAN_TOLERANCE_MIN            3.0
#define PERIOD_TOLERANCE_MIN          0.3

// Maneuver settings
