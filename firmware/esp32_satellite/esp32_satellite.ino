// =====================================================================
// esp32_satellite.ino - SATELLITE ON-BOARD COMPUTER (single file for Arduino IDE)
//
// BEFORE UPLOADING:
//   1) Arduino IDE -> Tools -> Manage Libraries -> search for "ArduinoJson" (by Benoit Blanchon)
//      and install version 7.x (NOT v6: the API changed and v6 won't compile).
//   2) Tools -> Board -> esp32 -> "ESP32 Dev Module" (or your specific board).
//      If the board has native USB (ESP32-S3 / C3): Tools -> "USB CDC On Boot" -> Enabled.
//   3) Tools -> Port -> select your board's port, then click Upload.
//   4) After Upload, CLOSE the Serial Monitor (Python needs the port).
//
// HOW IT WORKS: setup() runs once; loop() runs forever but NEVER blocks. On each iteration,
// it checks if a new JSON line has arrived from the PC. If yes, it processes it.
//
// PC -> ESP32 (one JSON line per message, terminated by '\n', 115200 baud). Contains "t" (mission
// time) and ONLY the fields of the sensors that just sampled:
//   {"t":12.0,"gyro":[x,y,z],"mag":[x,y,z],"q":[w,x,y,z],"sun":[x,y,z],"eclipse":0,
//    "pos":[x,y,z],"vel":[x,y,z],"rw":[r1,r2,r3,r4],"tank":[xeno,chem]}
//   {"cmd":"reset"}   resets the internal state (all actuators off)
//   {"cmd":"ping"}    replies with {"log":"pong"} (used to check the link)
//
// ESP32 -> PC (one JSON line ONLY when an actuator state changes; otherwise silence):
//   {"t":12.0,"hall":100,"rw":[r1,r2,r3,r4],"mtq":[x,y,z],"rcs":[0,0,0,0,0,0,0,0],"log":"text"}
//   hall = % power (0 = off); rw = desired speed [RPM, with sign]; mtq = [A*m^2, with sign];
//   only the fields that actually changed are included.
//
// All the onboard logic (when to fire the Hall thruster, how to keep the camera pointed at nadir,
// when to dump wheel momentum) is down in the "ONBOARD SOFTWARE" section. Tuning thresholds are
// in the PARAMETERS section.
// =====================================================================
#include <ArduinoJson.h>
#include "sim_params.h"         // Generated by the Python simulator. DO NOT EDIT MANUALLY.
#include <math.h>
#include <stdio.h>

// Forward declaration needed because the Arduino IDE auto-generates function prototypes
// at the very top of the file. Since we use this struct in those prototypes, we have to
// declare it before the IDE's generated code tries to use it.
struct OrbitalElements;

// ======================= KNOWN SATELLITE CONSTANTS (CAD/design) =======================
static const double PI_D = 3.14159265358979323846;

// ===== GPIO PIN DEFINITIONS =====
// Status LED: shows the Hall thruster state (solid = firing, off = idle).
// Loopback: a jumper between pin 18 (output) and pin 19 (input) lets us
// self-verify the digital I/O channel every time we change state.
#define STATUS_LED_PIN     2    // Onboard LED (GPIO2 on most ESP32 DevKits)
#define LOOPBACK_OUT_PIN   18   // Connect to pin 19 with a jumper
#define LOOPBACK_IN_PIN    19   // Reads back the output (interface test)

// Reaction wheels: 4 in a pyramidal configuration. 
// Note: WHEEL_AXES, WHEEL_AXES_PINV, and WHEEL_NULLSPACE are defined in sim_params.h 
// (generated by Python), so we don't redefine them here.
static const double WHEEL_INERTIA = WHEEL_INERTIA_KGM2; // Alias for convenience
static const double RPM_MAX = MAX_WHEEL_SPEED_RPM;
static const double WHEEL_MAX_MOMENTUM = MAX_WHEEL_MOMENTUM_NMS;
static const double WHEEL_LOOP_TAU = WHEEL_LOOP_TAU_S;
static const double MAX_DIPOLE = MAX_MTQ_DIPOLE_AM2;

// Nominal average inertia for the PD controller. 
// We just take the average of the diagonal elements from the Python-generated header.
static const double AVG_INERTIA = (BODY_INERTIA_KGM2[0] + BODY_INERTIA_KGM2[1] + BODY_INERTIA_KGM2[2]) / 3.0;

// ======================= CONTROL LOGIC PARAMETERS (tunable) =======================
